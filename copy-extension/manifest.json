{
  "manifest_version": 3,
  "name": "DispatchEZ Capture",
  "version": "0.2.0",
  "description": "Right-click an order on Zagle to send it, with its products, straight to a warehouse's dispatch queue.",
  "permissions": ["contextMenus", "storage", "alarms", "scripting", "activeTab"],
  "host_permissions": ["https://*.supabase.co/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html"
  }
}
